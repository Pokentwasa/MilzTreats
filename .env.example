# Copy this to Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub — this file is placeholders only.

# --- PayFast (from your PayFast merchant dashboard) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Set on PayFast under Settings -> Integration. Required — without one, the
# ITN signature can be reproduced by anyone who sees a single real notification.
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# --- Supabase (from your Supabase project settings) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Used to build PayFast's notify_url/return_url/cancel_url
SITE_URL=https://treatsbymilz.co.za
